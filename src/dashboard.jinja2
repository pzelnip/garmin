                        {% else %}Hitting goal roughly half the time
                        {% endif %}
                    </div>
                </div>
            </div>
            {{ pass_fail_strip(data.stats.hyd_recent_30_goal_strip) }}
        </div>

        <div class="panel ki-panel"
             data-tooltip="Lifetime totals across every day with hydration data. Strip below shows the last 14 days' goal-met pattern.">
