                {% set short = data.stats.sleep_recent_14_short %}
                {% if short > 0 %}
                <div class="ki-icon ki-icon-rough">😴</div>
                <div class="ki-body">
                    <div class="ki-title">{{ short }} night{{ '' if short == 1 else 's' }} under 6h</div>
