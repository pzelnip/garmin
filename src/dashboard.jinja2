<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Steps Dashboard</title>
    <link rel="shortcut icon" href="/static/favicon.png" />
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <style>
        :root {
            --bg: #0f1419;
            --panel: #1a1f2e;
            --panel-2: #232a3d;
            --text: #e6e8ec;
            --text-dim: #8a92a6;
            --accent: #5eead4;
            --accent-2: #818cf8;
            --warn: #fbbf24;
            --danger: #f87171;
            --hyd: #38bdf8;
            --sleep: #a78bfa;
            --grid: #2a3147;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            padding: 24px;
        }
        h1 {
            font-weight: 700;
            font-size: 32px;
            margin: 0 0 8px;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .subtitle { color: var(--text-dim); margin-bottom: 28px; }
        h2 { font-weight: 600; font-size: 18px; margin: 0 0 16px; color: var(--text); }
        .grid {
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            margin-bottom: 24px;
        }
        .panel {
            background: var(--panel);
            border: 1px solid var(--grid);
            border-radius: 12px;
            padding: 20px;
        }
        .stat-label {
            color: var(--text-dim);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 500;
            margin-bottom: 8px;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 700;
            line-height: 1.1;
        }
        .stat-sub {
            color: var(--text-dim);
            font-size: 12px;
            margin-top: 6px;
        }
        .accent { color: var(--accent); }
        .accent-2 { color: var(--accent-2); }
        .warn { color: var(--warn); }
        .hyd { color: var(--hyd); }
        .sleep { color: var(--sleep); }
        /* Hydration heatmap palette */
        .hm-cell.hyd-l0 { background: #2d3748; }
        .hm-cell.hyd-l1 { background: #075985; }
        .hm-cell.hyd-l2 { background: #0369a1; }
        .hm-cell.hyd-l3 { background: #0284c7; }
        .hm-cell.hyd-l4 { background: #38bdf8; box-shadow: 0 0 4px rgba(56,189,248,0.6); }
        .chart-grid {
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            margin-bottom: 24px;
        }
        .chart-panel {
            background: var(--panel);
            border: 1px solid var(--grid);
            border-radius: 12px;
            padding: 20px;
        }
        .chart-panel.wide { grid-column: 1 / -1; }
        .chart-wrap {
            position: relative;
            height: 280px;
        }
        .chart-wrap.tall { height: 360px; }
        table {
            width: 100%;
            border-collapse: collapse;
            color: var(--text);
            font-size: 14px;
        }
        th, td {
            text-align: left;
            padding: 8px 12px;
            border-bottom: 1px solid var(--grid);
        }
        th {
            color: var(--text-dim);
            font-weight: 500;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        td.num { text-align: right; font-variant-numeric: tabular-nums; }
        tr:last-child td { border-bottom: none; }
        .tables-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 16px;
        }
        /* Calendar heatmap */
        .heatmap {
            display: grid;
            grid-auto-flow: column;
            grid-template-rows: repeat(7, 12px);
            gap: 3px;
            overflow-x: auto;
            padding-bottom: 8px;
        }
        .hm-cell {
            width: 12px;
            height: 12px;
            border-radius: 2px;
            background: var(--panel-2);
        }
        .hm-cell.l-1 { background: var(--panel-2); }
        .hm-cell.l0 { background: #2d3748; }
        .hm-cell.l1 { background: #1e6f5c; }
        .hm-cell.l2 { background: #2da58e; }
        .hm-cell.l3 { background: #4fd1c5; }
        .hm-cell.l4 { background: #5eead4; box-shadow: 0 0 4px rgba(94,234,212,0.6); }
        .legend {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-dim);
            font-size: 12px;
            margin-top: 12px;
        }
        .legend-cell {
            width: 12px;
            height: 12px;
            border-radius: 2px;
        }
        .streak-current {
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #0f1419;
            padding: 16px;
            border-radius: 10px;
            font-weight: 600;
        }
        /* Tabs */
        .tabs {
            display: flex;
            gap: 4px;
            border-bottom: 1px solid var(--grid);
            margin: 0 0 24px;
        }
        .tab-btn {
            background: transparent;
            color: var(--text-dim);
            border: none;
            border-bottom: 2px solid transparent;
            padding: 10px 18px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s;
        }
        .tab-btn:hover { color: var(--text); }
        .tab-btn.active {
            color: var(--text);
            border-bottom-color: var(--accent);
        }
        .tab-btn[data-tab="water"].active { border-bottom-color: var(--hyd); }
        .tab-btn[data-tab="sleep"].active { border-bottom-color: var(--sleep); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
        .empty-state {
            text-align: center;
            color: var(--text-dim);
            padding: 60px 20px;
            font-size: 15px;
        }
    </style>
</head>
<body>
    <h1>Health Dashboard</h1>
    <div class="subtitle">{{ data.stats.total_days }} days tracked · {{ "{:,}".format(data.stats.total_steps) }} total steps</div>

    <!-- Tabs -->
    <div class="tabs" role="tablist">
        <button class="tab-btn active" data-tab="steps" role="tab">Steps</button>
        <button class="tab-btn" data-tab="water" role="tab">Water</button>
        <button class="tab-btn" data-tab="sleep" role="tab">Sleep</button>
    </div>

    <!-- ============================ STEPS TAB ============================ -->
    <div class="tab-panel active" data-tab="steps">
    <!-- Top-line stats -->
    <div class="grid">
        <div class="panel">
            <div class="stat-label">Days Recorded</div>
            <div class="stat-value">{{ "{:,}".format(data.stats.total_days) }}</div>
            <div class="stat-sub">{{ data.stats.num_streaks }} streaks logged</div>
        </div>
        <div class="panel">
            <div class="stat-label">Total Steps</div>
            <div class="stat-value accent">{{ "{:,}".format(data.stats.total_steps) }}</div>
            <div class="stat-sub">{{ "{:,}".format(data.stats.total_distance_km) }} km traveled</div>
        </div>
        <div class="panel">
            <div class="stat-label">Avg Steps / Day</div>
            <div class="stat-value">{{ "{:,}".format(data.stats.avg_steps) }}</div>
            <div class="stat-sub">Best day: {{ data.stats.dow_best }}</div>
        </div>
        <div class="panel">
            <div class="stat-label">Goal Met</div>
            <div class="stat-value accent-2">{{ data.stats.goal_days }}</div>
            <div class="stat-sub">{{ "%.1f"|format(data.stats.goal_pct) }}% of days</div>
        </div>
        <div class="panel">
            <div class="stat-label">Floors Climbed</div>
            <div class="stat-value warn">{{ "{:,}".format(data.stats.total_floors) }}</div>
            <div class="stat-sub">lifetime</div>
        </div>
        {% if data.current_streak %}
        <div class="panel" style="grid-column: span 2;">
            <div class="stat-label">Current Streak</div>
            <div class="streak-current">
                {{ data.current_streak.days }} day{{ '' if data.current_streak.days == 1 else 's' }} —
                {{ data.current_streak.start }} → {{ data.current_streak.end }}
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Heatmap -->
    <div class="chart-panel" style="margin-bottom: 24px;">
        <h2>Activity Heatmap — Last 365 Days</h2>
        <div class="heatmap" id="heatmap"></div>
        <div class="legend">
            <span>Less</span>
            <span class="legend-cell l0"></span>
            <span class="legend-cell l1"></span>
            <span class="legend-cell l2"></span>
            <span class="legend-cell l3"></span>
            <span class="legend-cell l4"></span>
            <span>More (goal met)</span>
        </div>
    </div>

    <!-- Charts -->
    <div class="chart-grid">
        <div class="chart-panel wide">
            <h2>Daily Steps with 7-Day & 30-Day Rolling Average</h2>
            <div class="chart-wrap tall"><canvas id="recentChart"></canvas></div>
        </div>

        <div class="chart-panel">
            <h2>Average Steps by Day of Week</h2>
            <div class="chart-wrap"><canvas id="dowChart"></canvas></div>
        </div>

        <div class="chart-panel">
            <h2>Step Count Distribution</h2>
            <div class="chart-wrap"><canvas id="histChart"></canvas></div>
        </div>

        <div class="chart-panel wide">
            <h2>Monthly Step Totals & Goal-Met %</h2>
            <div class="chart-wrap tall"><canvas id="monthlyChart"></canvas></div>
        </div>

        <div class="chart-panel wide">
            <h2>Cumulative Steps</h2>
            <div class="chart-wrap"><canvas id="cumulativeChart"></canvas></div>
        </div>

        {% if data.charts.rhr.values %}
        <div class="chart-panel">
            <h2>Resting Heart Rate</h2>
            <div class="chart-wrap"><canvas id="rhrChart"></canvas></div>
        </div>
        {% endif %}

        {% if data.charts.stress.values %}
        <div class="chart-panel">
            <h2>Average Stress Level</h2>
            <div class="chart-wrap"><canvas id="stressChart"></canvas></div>
        </div>
        {% endif %}

        {% if data.charts.weight.values %}
        <div class="chart-panel">
            <h2>Weight (lbs)</h2>
            <div class="chart-wrap"><canvas id="weightChart"></canvas></div>
        </div>
        {% endif %}

        {% if data.charts.floors.values %}
        <div class="chart-panel">
            <h2>Floors Climbed (last 365 days)</h2>
            <div class="chart-wrap"><canvas id="floorsChart"></canvas></div>
        </div>
        {% endif %}

    </div>

    <!-- Tables -->
    <div class="tables-grid">
        <div class="chart-panel">
            <h2>Top 10 Streaks</h2>
            <table>
                <thead><tr><th>#</th><th>Days</th><th>Start</th><th>End</th></tr></thead>
                <tbody>
                {% for s in data.top_streaks %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td class="num">{{ s.days }}</td>
                        <td>{{ s.start }}</td>
                        <td>{{ s.end }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="chart-panel">
            <h2>Top 10 Step Days</h2>
            <table>
                <thead><tr><th>#</th><th>Day</th><th>Steps</th></tr></thead>
                <tbody>
                {% for e in data.top_step_days %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ e.day }}</td>
                        <td class="num">{{ "{:,}".format(e.steps) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="chart-panel">
            <h2>Bottom 10 Step Days</h2>
            <table>
                <thead><tr><th>#</th><th>Day</th><th>Steps</th></tr></thead>
                <tbody>
                {% for e in data.bottom_step_days %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ e.day }}</td>
                        <td class="num">{{ "{:,}".format(e.steps) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    </div>
    <!-- /STEPS TAB -->

    <!-- ============================ WATER TAB ============================ -->
    <div class="tab-panel" data-tab="water">
    {% if data.stats.hyd_total_days %}
    <div class="grid">
        <div class="panel">
            <div class="stat-label">Avg Water / Day</div>
            <div class="stat-value hyd">{{ "{:,}".format(data.stats.hyd_avg_ml) }} ml</div>
            <div class="stat-sub">{{ data.stats.hyd_total_days }} days tracked</div>
        </div>
        <div class="panel">
            <div class="stat-label">Hydration Goal Met</div>
            <div class="stat-value hyd">{{ data.stats.hyd_goal_days }}</div>
            <div class="stat-sub">{{ "%.1f"|format(data.stats.hyd_goal_pct) }}% of tracked days</div>
        </div>
        <div class="panel">
            <div class="stat-label">Total Water</div>
            <div class="stat-value hyd">{{ "{:,}".format(data.stats.hyd_total_liters) }} L</div>
            <div class="stat-sub">lifetime</div>
        </div>
    </div>

    <div class="chart-panel" style="margin-bottom: 24px;">
        <h2>Hydration Heatmap — Last 365 Days</h2>
        <div class="heatmap" id="hydHeatmap"></div>
        <div class="legend">
            <span>Less</span>
            <span class="legend-cell hyd-l0"></span>
            <span class="legend-cell hyd-l1"></span>
            <span class="legend-cell hyd-l2"></span>
            <span class="legend-cell hyd-l3"></span>
            <span class="legend-cell hyd-l4"></span>
            <span>More (goal met)</span>
        </div>
    </div>

    <div class="chart-grid">
        <div class="chart-panel wide">
            <h2>Daily Hydration vs Goal — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="hydTimelineChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2>Average Water by Day of Week</h2>
            <div class="chart-wrap"><canvas id="hydDowChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2>Steps vs Water (last 365 days)</h2>
            <div class="chart-wrap"><canvas id="hydScatterChart"></canvas></div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">No hydration data yet. Once Garmin Connect logs water intake for a day, it will show up here.</div>
    {% endif %}
    </div>
    <!-- /WATER TAB -->

    <!-- ============================ SLEEP TAB ============================ -->
    <div class="tab-panel" data-tab="sleep">
    {% if data.stats.sleep_total_days %}
    <div class="grid">
        <div class="panel">
            <div class="stat-label">Avg Sleep / Night</div>
            <div class="stat-value sleep">{{ data.stats.sleep_avg_hours_str }}</div>
            <div class="stat-sub">{{ data.stats.sleep_total_days }} nights tracked</div>
        </div>
        <div class="panel">
            <div class="stat-label">Avg Sleep Score</div>
            <div class="stat-value sleep">{{ data.stats.sleep_avg_score }}</div>
            <div class="stat-sub">across {{ data.stats.sleep_scored_days }} scored nights</div>
        </div>
    </div>

    <div class="chart-grid">
        <div class="chart-panel wide">
            <h2>Sleep Duration & Score — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="sleepTimelineChart"></canvas></div>
        </div>
        <div class="chart-panel wide">
            <h2>Sleep Stage Breakdown — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="sleepStagesChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2>Average Sleep by Day of Week (hours)</h2>
            <div class="chart-wrap"><canvas id="sleepDowChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2>Sleep Duration vs Score (last 365 days)</h2>
            <div class="chart-wrap"><canvas id="sleepScatterChart"></canvas></div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">No sleep data yet. Sleep data populates from the next Garmin sync once the device has been worn at night.</div>
    {% endif %}
    </div>
    <!-- /SLEEP TAB -->

    <script>
        const charts = {{ charts_json | safe }};

        Chart.defaults.color = '#8a92a6';
        Chart.defaults.borderColor = '#2a3147';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const accent = '#5eead4';
        const accent2 = '#818cf8';
        const warn = '#fbbf24';
        const danger = '#f87171';
        const grid = '#2a3147';

        function gridOpts(showX = true) {
            return {
                x: { grid: { color: grid }, ticks: { color: '#8a92a6', maxRotation: 0, autoSkip: true, maxTicksLimit: 12 } },
                y: { grid: { color: grid }, ticks: { color: '#8a92a6' } }
            };
        }

        // Recent steps with rolling averages
        new Chart(document.getElementById('recentChart'), {
            type: 'line',
            data: {
                labels: charts.recent.labels,
                datasets: [
                    {
                        label: 'Daily steps',
                        data: charts.recent.steps,
                        backgroundColor: 'rgba(94, 234, 212, 0.15)',
                        borderColor: 'rgba(94, 234, 212, 0.4)',
                        borderWidth: 1,
                        pointRadius: 0,
                        type: 'bar'
                    },
                    {
                        label: '7-day avg',
                        data: charts.recent.rolling_7,
                        borderColor: accent2,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.3
                    },
                    {
                        label: '30-day avg',
                        data: charts.recent.rolling_30,
                        borderColor: warn,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: '#e6e8ec' } } },
                scales: gridOpts()
            }
        });

        // Day-of-week bar chart
        new Chart(document.getElementById('dowChart'), {
            type: 'bar',
            data: {
                labels: charts.dow.labels,
                datasets: [{
                    label: 'Avg steps',
                    data: charts.dow.values,
                    backgroundColor: charts.dow.labels.map((_, i) =>
                        i === charts.dow.values.indexOf(Math.max(...charts.dow.values)) ? accent : accent2
                    ),
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: gridOpts()
            }
        });

        // Histogram
        new Chart(document.getElementById('histChart'), {
            type: 'bar',
            data: {
                labels: charts.histogram.labels,
                datasets: [{
                    label: 'Days',
                    data: charts.histogram.values,
                    backgroundColor: accent,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: gridOpts()
            }
        });

        // Monthly totals + goal pct (dual axis)
        new Chart(document.getElementById('monthlyChart'), {
            type: 'bar',
            data: {
                labels: charts.monthly.labels,
                datasets: [
                    {
                        label: 'Total steps',
                        data: charts.monthly.totals,
                        backgroundColor: accent,
                        yAxisID: 'y',
                        borderRadius: 4
                    },
                    {
                        label: 'Goal met %',
                        data: charts.monthly.goal_pct,
                        type: 'line',
                        borderColor: warn,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 3,
                        pointBackgroundColor: warn,
                        yAxisID: 'y1',
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: '#e6e8ec' } } },
                scales: {
                    x: { grid: { color: grid }, ticks: { color: '#8a92a6' } },
                    y: { grid: { color: grid }, ticks: { color: '#8a92a6' }, title: { display: true, text: 'Steps', color: '#8a92a6' } },
                    y1: {
                        position: 'right',
                        grid: { display: false },
                        ticks: { color: '#fbbf24', callback: v => v + '%' },
                        min: 0,
                        max: 100,
                        title: { display: true, text: 'Goal met %', color: '#fbbf24' }
                    }
                }
            }
        });

        // Cumulative
        new Chart(document.getElementById('cumulativeChart'), {
            type: 'line',
            data: {
                labels: charts.cumulative.labels,
                datasets: [{
                    label: 'Cumulative steps',
                    data: charts.cumulative.values,
                    borderColor: accent,
                    backgroundColor: 'rgba(94, 234, 212, 0.15)',
                    borderWidth: 2,
                    fill: true,
                    pointRadius: 0,
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: gridOpts()
            }
        });

        function simpleLine(canvasId, labels, values, color) {
            const el = document.getElementById(canvasId);
            if (!el) return;
            new Chart(el, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        borderColor: color,
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });
        }

        simpleLine('rhrChart', charts.rhr.labels, charts.rhr.values, danger);
        simpleLine('stressChart', charts.stress.labels, charts.stress.values, warn);
        simpleLine('weightChart', charts.weight.labels, charts.weight.values, accent2);

        if (charts.floors.values.length) {
            new Chart(document.getElementById('floorsChart'), {
                type: 'bar',
                data: {
                    labels: charts.floors.labels,
                    datasets: [{
                        data: charts.floors.values,
                        backgroundColor: warn,
                        borderRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });
        }

        // Heatmap
        const heatmapEl = document.getElementById('heatmap');
        charts.heatmap.forEach(d => {
            const cell = document.createElement('div');
            cell.className = `hm-cell l${d.level}`;
            cell.title = `${d.date} — ${d.level === -1 ? 'no data' : 'level ' + d.level}`;
            cell.style.gridRow = d.weekday + 1;
            heatmapEl.appendChild(cell);
        });

        // Hydration charts (only render if hydration data exists)
        const hydTimelineEl = document.getElementById('hydTimelineChart');
        if (hydTimelineEl) {
            const hyd = '#38bdf8';
            new Chart(hydTimelineEl, {
                type: 'bar',
                data: {
                    labels: charts.hyd_timeline.labels,
                    datasets: [
                        {
                            label: 'Water consumed (ml)',
                            data: charts.hyd_timeline.consumed,
                            backgroundColor: 'rgba(56, 189, 248, 0.6)',
                            borderColor: hyd,
                            borderWidth: 1,
                        },
                        {
                            label: 'Goal (ml)',
                            data: charts.hyd_timeline.goals,
                            type: 'line',
                            borderColor: warn,
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            pointRadius: 0,
                            borderDash: [4, 4],
                            tension: 0,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: gridOpts()
                }
            });

            new Chart(document.getElementById('hydDowChart'), {
                type: 'bar',
                data: {
                    labels: charts.hyd_dow.labels,
                    datasets: [{
                        label: 'Avg ml',
                        data: charts.hyd_dow.values,
                        backgroundColor: hyd,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });

            new Chart(document.getElementById('hydScatterChart'), {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Day',
                        data: charts.hyd_scatter,
                        backgroundColor: 'rgba(56, 189, 248, 0.6)',
                        borderColor: hyd,
                        pointRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Steps', color: '#8a92a6' }
                        },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Water (ml)', color: '#8a92a6' }
                        }
                    }
                }
            });

            // Hydration heatmap
            const hydHeatmapEl = document.getElementById('hydHeatmap');
            if (hydHeatmapEl) {
                charts.hyd_heatmap.forEach(d => {
                    const cell = document.createElement('div');
                    cell.className = d.level === -1 ? 'hm-cell l-1' : `hm-cell hyd-l${d.level}`;
                    cell.title = `${d.date} — ${d.level === -1 ? 'no data' : 'level ' + d.level}`;
                    cell.style.gridRow = d.weekday + 1;
                    hydHeatmapEl.appendChild(cell);
                });
            }
        }

        // Sleep charts (only render if sleep data exists)
        const sleepTimelineEl = document.getElementById('sleepTimelineChart');
        if (sleepTimelineEl) {
            const sleepColor = '#a78bfa';
            // Convert seconds to hours for the duration display
            const sleepHours = charts.sleep_timeline.totals.map(
                v => v == null ? null : +(v / 3600).toFixed(2)
            );
            new Chart(sleepTimelineEl, {
                type: 'bar',
                data: {
                    labels: charts.sleep_timeline.labels,
                    datasets: [
                        {
                            label: 'Sleep (hours)',
                            data: sleepHours,
                            backgroundColor: 'rgba(167, 139, 250, 0.6)',
                            borderColor: sleepColor,
                            borderWidth: 1,
                            yAxisID: 'y',
                        },
                        {
                            label: 'Sleep score',
                            data: charts.sleep_timeline.scores,
                            type: 'line',
                            borderColor: warn,
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            pointRadius: 2,
                            pointBackgroundColor: warn,
                            yAxisID: 'y1',
                            tension: 0.3,
                            spanGaps: true,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: {
                        x: { grid: { color: grid }, ticks: { color: '#8a92a6', maxTicksLimit: 12 } },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Hours', color: '#8a92a6' },
                            beginAtZero: true,
                        },
                        y1: {
                            position: 'right',
                            grid: { display: false },
                            ticks: { color: '#fbbf24' },
                            min: 0,
                            max: 100,
                            title: { display: true, text: 'Score', color: '#fbbf24' },
                        }
                    }
                }
            });

            // Stacked sleep stages — convert seconds → minutes for readability
            const toMinutes = arr => arr.map(v => Math.round(v / 60));
            new Chart(document.getElementById('sleepStagesChart'), {
                type: 'bar',
                data: {
                    labels: charts.sleep_timeline.labels,
                    datasets: [
                        {
                            label: 'Deep',
                            data: toMinutes(charts.sleep_timeline.deep),
                            backgroundColor: '#4c1d95',
                        },
                        {
                            label: 'REM',
                            data: toMinutes(charts.sleep_timeline.rem),
                            backgroundColor: '#7c3aed',
                        },
                        {
                            label: 'Light',
                            data: toMinutes(charts.sleep_timeline.light),
                            backgroundColor: '#a78bfa',
                        },
                        {
                            label: 'Awake',
                            data: toMinutes(charts.sleep_timeline.awake),
                            backgroundColor: '#fbbf24',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: {
                        x: {
                            stacked: true,
                            grid: { color: grid },
                            ticks: { color: '#8a92a6', maxTicksLimit: 12 }
                        },
                        y: {
                            stacked: true,
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Minutes', color: '#8a92a6' },
                        }
                    }
                }
            });

            // Sleep by day-of-week (hours)
            new Chart(document.getElementById('sleepDowChart'), {
                type: 'bar',
                data: {
                    labels: charts.sleep_dow.labels,
                    datasets: [{
                        label: 'Avg hours',
                        data: charts.sleep_dow.values,
                        backgroundColor: sleepColor,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });

            // Sleep duration vs score scatter
            new Chart(document.getElementById('sleepScatterChart'), {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Night',
                        data: charts.sleep_scatter,
                        backgroundColor: 'rgba(167, 139, 250, 0.6)',
                        borderColor: sleepColor,
                        pointRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Hours slept', color: '#8a92a6' },
                        },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            min: 0, max: 100,
                            title: { display: true, text: 'Sleep score', color: '#8a92a6' },
                        }
                    }
                }
            });
        }

        // -------- Tab switching --------
        const TAB_STORAGE_KEY = 'dashboard.activeTab';
        const tabButtons = document.querySelectorAll('.tab-btn');
        const tabPanels = document.querySelectorAll('.tab-panel');

        function activateTab(name) {
            tabButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.tab === name);
            });
            tabPanels.forEach(panel => {
                const isActive = panel.dataset.tab === name;
                panel.classList.toggle('active', isActive);
                if (isActive) {
                    // Resize any Chart.js instances inside the now-visible panel
                    panel.querySelectorAll('canvas').forEach(canvas => {
                        const chart = Chart.getChart(canvas);
                        if (chart) chart.resize();
                    });
                }
            });
            try { localStorage.setItem(TAB_STORAGE_KEY, name); } catch (_) {}
        }

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => activateTab(btn.dataset.tab));
        });

        // Restore last-selected tab if it still exists
        try {
            const saved = localStorage.getItem(TAB_STORAGE_KEY);
            if (saved && document.querySelector(`.tab-panel[data-tab="${saved}"]`)) {
                activateTab(saved);
            }
        } catch (_) {}
    </script>
</body>
</html>
