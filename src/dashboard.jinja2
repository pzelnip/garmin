            <div class="ki-row">
                <div class="ki-icon ki-icon-neutral">📊</div>
                <div class="ki-body">
                    <div class="ki-title">{{ "{:,}".format(data.stats.hyd_total_liters) }} L consumed</div>
                    <div class="ki-sub">across {{ data.stats.hyd_total_days }} tracked days · {{ "{:,}".format(data.stats.hyd_goal_days) }} goal-met days</div>
                </div>
