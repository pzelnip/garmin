    <div class="chart-grid">
        {{ weekly_comparison_panel(data.stats.sleep_weekly_comparison, 'sleep', 'hms') }}

        <div class="chart-panel wide">
            <h2 data-tooltip="Nightly sleep duration (bars, left axis) with the sleep score overlaid as a line (right axis, 0–100).">Sleep Duration & Score — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="sleepTimelineChart"></canvas></div>
