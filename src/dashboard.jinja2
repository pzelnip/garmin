    {% endif %}
    </div>
    <!-- /SLEEP TAB -->

    {% if git_sha %}
    <div class="version-footer">
        <a href="https://github.com/pzelnip/garmin/commit/{{ git_sha }}"
           target="_blank" rel="noopener noreferrer">{{ git_sha }}</a>
    </div>
    {% endif %}

    <script>
        const charts = {{ charts_json | safe }};

        Chart.defaults.color = '#8a92a6';
        Chart.defaults.borderColor = '#2a3147';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const accent = '#5eead4';
        const accent2 = '#818cf8';
        const warn = '#fbbf24';
        const danger = '#f87171';
        const grid = '#2a3147';

        function gridOpts(showX = true) {
            return {
                x: { grid: { color: grid }, ticks: { color: '#8a92a6', maxRotation: 0, autoSkip: true, maxTicksLimit: 12 } },
                y: { grid: { color: grid }, ticks: { color: '#8a92a6' } }
            };
        }

        // Recent steps with rolling averages
        new Chart(document.getElementById('recentChart'), {
            type: 'line',
            data: {
                labels: charts.recent.labels,
                datasets: [
                    {
                        label: 'Daily steps',
                        data: charts.recent.steps,
                        backgroundColor: 'rgba(94, 234, 212, 0.15)',
                        borderColor: 'rgba(94, 234, 212, 0.4)',
                        borderWidth: 1,
                        pointRadius: 0,
                        type: 'bar'
                    },
                    {
                        label: '7-day avg',
                        data: charts.recent.rolling_7,
                        borderColor: accent2,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.3
                    },
                    {
                        label: '30-day avg',
                        data: charts.recent.rolling_30,
                        borderColor: warn,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.3
                    },
                    {
                        label: 'Daily goal',
                        data: charts.recent.goals,
                        borderColor: 'rgba(248, 113, 113, 0.7)',
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        borderDash: [6, 4],
                        pointRadius: 0,
                        stepped: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: '#e6e8ec' } } },
                scales: gridOpts()
            }
        });

        // Day-of-week bar chart
        new Chart(document.getElementById('dowChart'), {
            type: 'bar',
            data: {
                labels: charts.dow.labels,
                datasets: [{
                    label: 'Avg steps',
                    data: charts.dow.values,
                    backgroundColor: charts.dow.labels.map((_, i) =>
                        i === charts.dow.values.indexOf(Math.max(...charts.dow.values)) ? accent : accent2
                    ),
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: gridOpts()
            }
        });

        // Histogram
        new Chart(document.getElementById('histChart'), {
            type: 'bar',
            data: {
                labels: charts.histogram.labels,
                datasets: [{
                    label: 'Days',
                    data: charts.histogram.values,
                    backgroundColor: accent,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: gridOpts()
            }
        });

        // Monthly totals + goal pct (dual axis)
        new Chart(document.getElementById('monthlyChart'), {
            type: 'bar',
            data: {
                labels: charts.monthly.labels,
                datasets: [
                    {
                        label: 'Total steps',
                        data: charts.monthly.totals,
                        backgroundColor: accent,
                        yAxisID: 'y',
                        borderRadius: 4
                    },
                    {
                        label: 'Goal met %',
                        data: charts.monthly.goal_pct,
                        type: 'line',
                        borderColor: warn,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 3,
                        pointBackgroundColor: warn,
                        yAxisID: 'y1',
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: '#e6e8ec' } } },
                scales: {
                    x: { grid: { color: grid }, ticks: { color: '#8a92a6' } },
                    y: { grid: { color: grid }, ticks: { color: '#8a92a6' }, title: { display: true, text: 'Steps', color: '#8a92a6' } },
                    y1: {
                        position: 'right',
                        grid: { display: false },
                        ticks: { color: '#fbbf24', callback: v => v + '%' },
                        min: 0,
                        max: 100,
                        title: { display: true, text: 'Goal met %', color: '#fbbf24' }
                    }
                }
            }
        });

        // Cumulative — compute 5M-step milestone crossings. Each crossing
        // gets a yellow point (rendered as a scatter dataset for the legend)
        // plus a label-box annotation tethered to it by a short dashed
        // vertical line.
        const MILESTONE_STEP = 5_000_000;
        const milestones = [];
        let nextMilestone = MILESTONE_STEP;
        for (let i = 0; i < charts.cumulative.values.length; i++) {
            while (charts.cumulative.values[i] >= nextMilestone) {
                milestones.push({
                    value: nextMilestone,
                    label: charts.cumulative.labels[i],
                });
                nextMilestone += MILESTONE_STEP;
            }
        }

        // Build the milestone point dataset (so the legend shows it).
        const milestonePointData = milestones.map(m => ({
            x: m.label,
            y: m.value,
        }));

        // Build the per-milestone annotations: a short dashed vertical line
        // from the point up into the label box, plus the box itself.
        const labelColor = '#a78bfa';  // violet
        const labelBg = 'rgba(15, 20, 25, 0.92)';
        const annotations = {};
        milestones.forEach((m, i) => {
            const mLabel = `${(m.value / 1_000_000).toFixed(0)}M`;
            // Short dashed vertical line just above the point, ending where
            // the label box starts.
            annotations['tether' + i] = {
                type: 'line',
                xMin: m.label,
                xMax: m.label,
                yMin: m.value,
                yMax: m.value + MILESTONE_STEP * 0.55,
                borderColor: labelColor,
                borderWidth: 1,
                borderDash: [3, 3],
            };
            // Label box centered above the point.
            annotations['lbl' + i] = {
                type: 'label',
                xValue: m.label,
                yValue: m.value,
                xAdjust: 0,
                yAdjust: -42,
                backgroundColor: labelBg,
                borderColor: labelColor,
                borderWidth: 1,
                borderRadius: 4,
                color: labelColor,
                font: { size: 11, weight: '600' },
                padding: { top: 4, bottom: 4, left: 8, right: 8 },
                content: [mLabel, m.label],
                textAlign: 'center',
            };
        });

        new Chart(document.getElementById('cumulativeChart'), {
            type: 'line',
            data: {
                labels: charts.cumulative.labels,
                datasets: [
                    {
                        label: 'Cumulative Steps',
                        data: charts.cumulative.values,
                        borderColor: accent,
                        backgroundColor: 'rgba(94, 234, 212, 0.15)',
                        borderWidth: 2,
                        fill: true,
                        pointRadius: 0,
                        tension: 0.2,
                    },
                    {
                        label: 'Milestones',
                        type: 'scatter',
                        data: milestonePointData,
                        backgroundColor: warn,
                        borderColor: warn,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        showLine: false,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    // Built-in legend is disabled — we render an HTML legend
                    // above the canvas (see the panel-header markup) so we
                    // can control spacing with plain CSS.
                    legend: { display: false },
                    annotation: { annotations: annotations },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => {
                                if (ctx.dataset.label === 'Milestones') {
                                    const m = (ctx.parsed.y / 1_000_000).toFixed(0);
                                    return `${m}M reached on ${ctx.parsed.x ?? milestones[ctx.dataIndex].label}`;
                                }
                                return `${ctx.parsed.y.toLocaleString()} steps`;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { color: grid }, ticks: { color: '#8a92a6', maxRotation: 0, autoSkip: true, maxTicksLimit: 12 } },
                    y: {
                        grid: { color: grid },
                        ticks: {
                            color: '#8a92a6',
                            callback: (v) => {
                                if (v >= 1_000_000) return (v / 1_000_000) + 'M';
                                if (v >= 1_000) return (v / 1_000) + 'k';
                                return v;
                            },
                        },
                        // Reserve headroom so the topmost milestone label box
                        // doesn't get clipped at the top of the chart. The
                        // label sits ~42px above its point, plus its own
                        // height — about 2 full milestone-grid-lines worth on
                        // a ~360px tall chart.
                        suggestedMax: (() => {
                            const dataMax = Math.max(...charts.cumulative.values);
                            return dataMax + MILESTONE_STEP * 2.5;
                        })(),
                    },
                },
            }
        });

        function simpleLine(canvasId, labels, values, color) {
            const el = document.getElementById(canvasId);
            if (!el) return null;
            return new Chart(el, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        borderColor: color,
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });
        }

        // Build range-filterable charts. Keep the full series alongside the chart
        // instance so a range-button click can re-slice without re-fetching.
        const rangeable = {};
        function registerRangeable(canvasId, labels, values, color) {
            const chart = simpleLine(canvasId, labels, values, color);
            if (chart) rangeable[canvasId] = { chart, labels, values };
        }
        registerRangeable('rhrChart', charts.rhr.labels, charts.rhr.values, danger);
        registerRangeable('stressChart', charts.stress.labels, charts.stress.values, warn);

        const weightEl = document.getElementById('weightChart');
        let weightChart = null;
        if (weightEl) {
            weightChart = new Chart(weightEl, {
                type: 'line',
                data: {
                    labels: charts.weight.labels,
                    datasets: [{
                        data: charts.weight.values,
                        borderColor: accent2,
                        backgroundColor: 'transparent',
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        zoom: {
                            zoom: {
                                drag: {
                                    enabled: true,
                                    backgroundColor: 'rgba(129, 140, 248, 0.2)',
                                    borderColor: accent2,
                                    borderWidth: 1,
                                },
                                mode: 'x',
                            },
                            // Disable wheel/pinch so only the drag gesture zooms
                            pan: { enabled: false },
                        }
                    },
                    scales: gridOpts()
                }
            });

            const resetBtn = document.getElementById('weightZoomReset');
            if (resetBtn) {
                resetBtn.addEventListener('click', () => weightChart.resetZoom());
            }
        }

        function applyRange(canvasId, days) {
            const entry = rangeable[canvasId];
            if (!entry) return;
            if (days === 'all' || !days) {
                entry.chart.data.labels = entry.labels;
                entry.chart.data.datasets[0].data = entry.values;
            } else {
                const cutoff = new Date();
                cutoff.setDate(cutoff.getDate() - Number(days));
                const cutoffIso = cutoff.toISOString().slice(0, 10);
                // Labels are ISO YYYY-MM-DD strings, so lexical compare works.
                const startIdx = entry.labels.findIndex(d => d >= cutoffIso);
                if (startIdx === -1) {
                    entry.chart.data.labels = [];
                    entry.chart.data.datasets[0].data = [];
                } else {
                    entry.chart.data.labels = entry.labels.slice(startIdx);
                    entry.chart.data.datasets[0].data = entry.values.slice(startIdx);
                }
            }
            entry.chart.update();
        }

        document.querySelectorAll('.range-controls').forEach(group => {
            const canvasId = group.dataset.canvas;
            group.querySelectorAll('.range-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    group.querySelectorAll('.range-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    applyRange(canvasId, btn.dataset.days);
                });
            });
        });

        if (charts.floors.values.length) {
            new Chart(document.getElementById('floorsChart'), {
                type: 'bar',
                data: {
                    labels: charts.floors.labels,
                    datasets: [{
                        data: charts.floors.values,
                        backgroundColor: warn,
                        borderRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });
        }

        // Heatmap
        const heatmapEl = document.getElementById('heatmap');
        const levelLabels = ['0 – 2.5k', '2.5k – 5k', '5k – 7.5k', '7.5k – 10k', '10k+'];
        charts.heatmap.forEach(d => {
            const cell = document.createElement('div');
            cell.className = d.level === -1 ? 'hm-cell l-1' : `hm-cell l${d.level}`;
            cell.title = `${d.date} — ${d.level === -1 ? 'no data' : levelLabels[d.level]}`;
            cell.style.gridRow = d.weekday + 1;
            heatmapEl.appendChild(cell);
        });

        // Hydration charts (only render if hydration data exists)
        const hydTimelineEl = document.getElementById('hydTimelineChart');
        if (hydTimelineEl) {
            const hyd = '#38bdf8';
            new Chart(hydTimelineEl, {
                type: 'bar',
                data: {
                    labels: charts.hyd_timeline.labels,
                    datasets: [
                        {
                            label: 'Water consumed (ml)',
                            data: charts.hyd_timeline.consumed,
                            backgroundColor: 'rgba(56, 189, 248, 0.6)',
                            borderColor: hyd,
                            borderWidth: 1,
                        },
                        {
                            label: 'Goal (ml)',
                            data: charts.hyd_timeline.goals,
                            type: 'line',
                            borderColor: warn,
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            pointRadius: 0,
                            borderDash: [4, 4],
                            tension: 0,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: gridOpts()
                }
            });

            new Chart(document.getElementById('hydDowChart'), {
                type: 'bar',
                data: {
                    labels: charts.hyd_dow.labels,
                    datasets: [{
                        label: 'Avg ml',
                        data: charts.hyd_dow.values,
                        backgroundColor: hyd,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });

            new Chart(document.getElementById('hydScatterChart'), {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Day',
                        data: charts.hyd_scatter,
                        backgroundColor: 'rgba(56, 189, 248, 0.6)',
                        borderColor: hyd,
                        pointRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Steps', color: '#8a92a6' }
                        },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Water (ml)', color: '#8a92a6' }
                        }
                    }
                }
            });

            // Hydration heatmap
            const hydHeatmapEl = document.getElementById('hydHeatmap');
            if (hydHeatmapEl) {
                const hydLabels = ['None', '< 50%', '50 – 75%', '75 – 100%', 'Goal met'];
                charts.hyd_heatmap.forEach(d => {
                    const cell = document.createElement('div');
                    cell.className = d.level === -1 ? 'hm-cell l-1' : `hm-cell hyd-l${d.level}`;
                    cell.title = `${d.date} — ${d.level === -1 ? 'no data' : hydLabels[d.level]}`;
                    cell.style.gridRow = d.weekday + 1;
                    hydHeatmapEl.appendChild(cell);
                });
            }
        }

        // Sleep charts (only render if sleep data exists)
        const sleepTimelineEl = document.getElementById('sleepTimelineChart');
        if (sleepTimelineEl) {
            const sleepColor = '#a78bfa';
            // Convert seconds to hours for the duration display
            const sleepHours = charts.sleep_timeline.totals.map(
                v => v == null ? null : +(v / 3600).toFixed(2)
            );
            new Chart(sleepTimelineEl, {
                type: 'bar',
                data: {
                    labels: charts.sleep_timeline.labels,
                    datasets: [
                        {
                            label: 'Sleep (hours)',
                            data: sleepHours,
                            backgroundColor: 'rgba(167, 139, 250, 0.6)',
                            borderColor: sleepColor,
                            borderWidth: 1,
                            yAxisID: 'y',
                        },
                        {
                            label: 'Sleep score',
                            data: charts.sleep_timeline.scores,
                            type: 'line',
                            borderColor: warn,
                            backgroundColor: 'transparent',
                            borderWidth: 2,
                            pointRadius: 2,
                            pointBackgroundColor: warn,
                            yAxisID: 'y1',
                            tension: 0.3,
                            spanGaps: true,
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: {
                        x: { grid: { color: grid }, ticks: { color: '#8a92a6', maxTicksLimit: 12 } },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Hours', color: '#8a92a6' },
                            beginAtZero: true,
                        },
                        y1: {
                            position: 'right',
                            grid: { display: false },
                            ticks: { color: '#fbbf24' },
                            min: 0,
                            max: 100,
                            title: { display: true, text: 'Score', color: '#fbbf24' },
                        }
                    }
                }
            });

            // Stacked sleep stages — convert seconds → minutes for readability
            const toMinutes = arr => arr.map(v => Math.round(v / 60));
            new Chart(document.getElementById('sleepStagesChart'), {
                type: 'bar',
                data: {
                    labels: charts.sleep_timeline.labels,
                    datasets: [
                        {
                            label: 'Deep',
                            data: toMinutes(charts.sleep_timeline.deep),
                            backgroundColor: '#4c1d95',
                        },
                        {
                            label: 'REM',
                            data: toMinutes(charts.sleep_timeline.rem),
                            backgroundColor: '#7c3aed',
                        },
                        {
                            label: 'Light',
                            data: toMinutes(charts.sleep_timeline.light),
                            backgroundColor: '#a78bfa',
                        },
                        {
                            label: 'Awake',
                            data: toMinutes(charts.sleep_timeline.awake),
                            backgroundColor: '#fbbf24',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#e6e8ec' } } },
                    scales: {
                        x: {
                            stacked: true,
                            grid: { color: grid },
                            ticks: { color: '#8a92a6', maxTicksLimit: 12 }
                        },
                        y: {
                            stacked: true,
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Minutes', color: '#8a92a6' },
                        }
                    }
                }
            });

            // Sleep by day-of-week (hours)
            new Chart(document.getElementById('sleepDowChart'), {
                type: 'bar',
                data: {
                    labels: charts.sleep_dow.labels,
                    datasets: [{
                        label: 'Avg hours',
                        data: charts.sleep_dow.values,
                        backgroundColor: sleepColor,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: gridOpts()
                }
            });

            // Sleep duration vs score scatter
            new Chart(document.getElementById('sleepScatterChart'), {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Night',
                        data: charts.sleep_scatter,
                        backgroundColor: 'rgba(167, 139, 250, 0.6)',
                        borderColor: sleepColor,
                        pointRadius: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            title: { display: true, text: 'Hours slept', color: '#8a92a6' },
                        },
                        y: {
                            grid: { color: grid },
                            ticks: { color: '#8a92a6' },
                            min: 0, max: 100,
                            title: { display: true, text: 'Sleep score', color: '#8a92a6' },
                        }
                    }
                }
            });
        }

        // -------- Tab switching --------
        const TAB_STORAGE_KEY = 'dashboard.activeTab';
        const tabButtons = document.querySelectorAll('.tab-btn');
        const tabPanels = document.querySelectorAll('.tab-panel');

        function activateTab(name) {
            tabButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.tab === name);
            });
            tabPanels.forEach(panel => {
                const isActive = panel.dataset.tab === name;
                panel.classList.toggle('active', isActive);
                if (isActive) {
                    // Resize any Chart.js instances inside the now-visible panel
                    panel.querySelectorAll('canvas').forEach(canvas => {
                        const chart = Chart.getChart(canvas);
                        if (chart) chart.resize();
                    });
                }
            });
            try { localStorage.setItem(TAB_STORAGE_KEY, name); } catch (_) {}
        }

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => activateTab(btn.dataset.tab));
        });

        // Restore last-selected tab if it still exists
        try {
            const saved = localStorage.getItem(TAB_STORAGE_KEY);
            if (saved && document.querySelector(`.tab-panel[data-tab="${saved}"]`)) {
                activateTab(saved);
            }
        } catch (_) {}

        // -------- Debug panel (toggle with ?) --------
        const debugBackdrop = document.getElementById('debug-backdrop');
        const debugPanel = document.getElementById('debug-panel');
        const debugStatus = document.getElementById('debug-status');
        const debugForceBtn = document.getElementById('debug-force-update');

        function openDebug() {
            debugBackdrop.classList.add('open');
        }
        function closeDebug() {
            debugBackdrop.classList.remove('open');
        }

        document.addEventListener('keydown', (e) => {
            const tag = (document.activeElement?.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea') return;
            const isOpen = debugBackdrop.classList.contains('open');
            if (e.key === '?') {
                e.preventDefault();
                isOpen ? closeDebug() : openDebug();
            } else if (e.key === 'Escape' && isOpen) {
                e.preventDefault();
                closeDebug();
            }
        });

        // Click on backdrop closes (clicking the panel itself doesn't propagate).
        debugBackdrop.addEventListener('click', closeDebug);

        function setDebugStatus(text, kind) {
            debugStatus.textContent = text;
            debugStatus.className = 'show ' + (kind || '');
        }

        debugForceBtn.addEventListener('click', async () => {
            if (!confirm('Force a git pull and restart the dashboard service? The page will become unreachable briefly.')) {
                return;
            }
            debugForceBtn.disabled = true;
            setDebugStatus('Update requested — server is restarting…', 'ok');
            try {
                const resp = await fetch('/api/force-update', { method: 'POST' });
                const data = await resp.json().catch(() => ({}));
                if (data.error) {
                    setDebugStatus('Failed: ' + data.error, 'err');
                    debugForceBtn.disabled = false;
                    return;
                }
                // The service restart will cut this connection. Wait a few
                // seconds then reload the page — by then the new server should
                // be up.
                setTimeout(() => location.reload(), 5000);
            } catch (e) {
                // Connection-reset is the expected outcome of the restart
                // killing this process. Treat any fetch failure as success and
                // reload.
                setDebugStatus('Server restarting — reloading…', 'ok');
                setTimeout(() => location.reload(), 5000);
            }
        });
    </script>
</body>
</html>
