             data-tooltip="The weekday with the highest all-time average water intake. Mini-bars show every weekday's average.">
            <div class="stat-label">Most Hydrated Day (All-Time)</div>
            <div class="ki-row">
                <div class="ki-icon ki-icon-great">💧</div>
                <div class="ki-body">
                    <div class="ki-title">{{ data.stats.hyd_dow_best.name_full }}s are your most hydrated days</div>
                    <div class="ki-sub">{{ "{:,}".format(data.stats.hyd_dow_best.delta|int) }} ml above weekly average</div>
