    <!-- ============================ MOOD TAB ============================ -->
    <div class="tab-panel" data-tab="mood">
    {% if data.stats.mood_total_days %}
    <div class="grid">
        <div class="panel mood-avg-panel"
             data-tooltip="All-time average mood across {{ data.stats.mood_total_days }} recorded days. The sparkline + delta below show the last 30 logged days vs the prior 30.">
            <div class="stat-label">Average Mood (All-Time)</div>
            <div class="mood-avg-row">
                <div class="stat-value mood">{{ data.stats.mood_avg }}</div>
                {% if data.stats.mood_30d_delta is not none %}
                    {% set d = data.stats.mood_30d_delta %}
                    <div class="mood-avg-delta {{ 'delta-up' if d > 0 else ('delta-down' if d < 0 else 'delta-flat') }}">
                        {% if d > 0 %}▲{% elif d < 0 %}▼{% else %}■{% endif %}
                        {{ "%.1f"|format(d|abs) }} over previous 30 days
                    </div>
                {% else %}
                    <div class="stat-sub">across {{ data.stats.mood_total_days }} days</div>
                {% endif %}
            </div>
            <div class="ki-viz"><canvas id="moodAvgSparkline"></canvas></div>
        </div>

        {# Insight 1: best weekday #}
        {% if data.stats.mood_dow_best %}
        <div class="panel ki-panel"
             data-tooltip="The weekday with the highest all-time average mood. Delta is best-day minus the average across recorded weekdays. Mini-bars show the average for each weekday.">
            <div class="stat-label">Happiest Day Of Week (All-Time)</div>
            <div class="ki-row">
                <div class="ki-icon ki-icon-great">📅</div>
                <div class="ki-body">
                    <div class="ki-title">{{ data.stats.mood_dow_best.name_full }}s are your happiest days</div>
                    <div class="ki-sub">{{ "%.1f"|format(data.stats.mood_dow_best.delta) }} points above weekly average</div>
                </div>
            </div>
            <div class="ki-viz"><canvas id="happiestDayMini"></canvas></div>
        </div>
        {% endif %}

        {# Insight 2: recent trend #}
        {% if data.stats.mood_30d_delta is not none %}
            {% set d = data.stats.mood_30d_delta %}
            {% if d >= 0.2 %}
                {% set ki_title = "You're on the right track" %}
                {% set ki_sub = 'Your mood has improved %.1f points over the last 30 days'|format(d) %}
                {% set ki_klass = 'ki-icon-great' %}
                {% set ki_emoji = '📈' %}
            {% elif d <= -0.2 %}
                {% set ki_title = "Mood has been dipping" %}
                {% set ki_sub = 'Down %.1f points over the last 30 days vs all-time'|format(d|abs) %}
                {% set ki_klass = 'ki-icon-rough' %}
                {% set ki_emoji = '📉' %}
            {% else %}
                {% set ki_title = "Mood is steady" %}
                {% set ki_sub = 'Within 0.2 of your all-time average over the last 30 days' %}
                {% set ki_klass = 'ki-icon-neutral' %}
                {% set ki_emoji = '➖' %}
            {% endif %}
            <div class="panel ki-panel"
                 data-tooltip="How the last 30 logged mood scores compare to your all-time average. The sparkline traces those 30 scores in order.">
                <div class="stat-label">Mood Trend</div>
                <div class="ki-row">
                    <div class="ki-icon {{ ki_klass }}">{{ ki_emoji }}</div>
                    <div class="ki-body">
                        <div class="ki-title">{{ ki_title }}</div>
                        <div class="ki-sub">{{ ki_sub }}</div>
                    </div>
                </div>
                <div class="ki-viz"><canvas id="moodTrendMini"></canvas></div>
            </div>
        {% endif %}

        {# Insight 3: rough days in last 14 logged days #}
        <div class="panel ki-panel"
             data-tooltip="Days in the last 14 logged where mood was rated 3 or lower. The colour strip shows each of those 14 days; redder dots are rougher.">
            <div class="stat-label">Recent Rough Days</div>
            {% if data.stats.mood_recent_14_rough > 0 %}
            <div class="ki-row">
                <div class="ki-icon ki-icon-rough">🩹</div>
                <div class="ki-body">
                    <div class="ki-title">{{ data.stats.mood_recent_14_rough }} rough day{{ 's' if data.stats.mood_recent_14_rough != 1 else '' }} in the last 14 days</div>
                    <div class="ki-sub">Try focusing on sleep and recovery</div>
                </div>
            </div>
            {% else %}
            <div class="ki-row">
                <div class="ki-icon ki-icon-great">✨</div>
                <div class="ki-body">
                    <div class="ki-title">No rough days recently</div>
                    <div class="ki-sub">Zero ≤3 scores in the last 14 logged days</div>
                </div>
            </div>
            {% endif %}
            <div class="ki-viz ki-dots" id="recentRoughDots"></div>
        </div>
    </div>

    <div class="chart-grid">
        {{ weekly_comparison_panel(data.stats.mood_weekly_comparison, 'mood', 'decimal') }}

        <div class="chart-panel wide">
            <div class="panel-header">
                <h2 data-tooltip="Daily mood (filled line) with 7-day and 30-day rolling averages overlaid. Use the range buttons to zoom the time window.">Mood with 7-Day &amp; 30-Day Rolling Average</h2>
                <div class="range-controls" id="mood-range">
                    <button class="range-btn" data-days="7">7d</button>
                    <button class="range-btn" data-days="30">30d</button>
                    <button class="range-btn active" data-days="90">90d</button>
                    <button class="range-btn" data-days="365">365d</button>
                    <button class="range-btn" data-days="all">All</button>
                </div>
            </div>
            <div class="chart-wrap tall"><canvas id="moodTimelineChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="Histogram of how often each mood score (1–10) was recorded. Bars are coloured using the same red→green palette as the chip selector and calendar.">Mood Distribution</h2>
            <div class="chart-wrap"><canvas id="moodDistChart"></canvas></div>
            {% macro mood_bucket(label, summary, klass, color, tip) %}
                <div class="hist-bucket mood-bucket {{ klass }}" data-tooltip="{{ tip }}">
                    <div class="mood-bucket-text">
                        <div class="hist-bucket-label">{{ label }}</div>
                        <div class="hist-bucket-value">{{ "{:,}".format(summary.count) }}</div>
                        <div class="mood-bucket-sub">{{ summary.pct }}% of days</div>
                    </div>
                    {% set circ = 100 %}
                    {% set offset = circ - (circ * summary.pct / 100) %}
                    <svg class="mood-bucket-donut" viewBox="0 0 40 40" aria-hidden="true">
                        <circle cx="20" cy="20" r="15.915" class="donut-track"></circle>
                        <circle cx="20" cy="20" r="15.915" class="donut-progress"
                                stroke="{{ color }}"
                                stroke-dasharray="{{ '%.2f'|format(circ - offset) }} {{ '%.2f'|format(offset) }}"
                                stroke-dashoffset="25"></circle>
                        <text x="20" y="21" class="donut-text">{{ summary.pct }}%</text>
                    </svg>
                </div>
            {% endmacro %}
            <div class="hist-summary">
                {{ mood_bucket('Rough Days (1–3)', data.stats.mood_dist_summary.rough, 'mood-rough', '#cc8c7f',
                    'Days where mood was rated 1, 2, or 3. The percentage is the share of all days with a recorded mood.') }}
                {{ mood_bucket('Average Days (4–6)', data.stats.mood_dist_summary.average, 'mood-average', '#a7b190',
                    'Days where mood was rated 4, 5, or 6 — the middle of the scale.') }}
                {{ mood_bucket('Great Days (7+)', data.stats.mood_dist_summary.great, 'mood-great', '#7cdda5',
                    'Days where mood was rated 7 or higher.') }}
            </div>
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="Average mood score per weekday across all recorded days. Best day is highlighted; the footer shows how far above the weekly average it sits.">Avg Mood by Day of Week</h2>
            <div class="chart-wrap"><canvas id="moodDowChart"></canvas></div>
            {% if data.stats.mood_dow_best %}
                {{ dow_best_footer(data.stats.mood_dow_best, "%.1f points above weekly average"|format(data.stats.mood_dow_best.delta)) }}
            {% endif %}
        </div>
        <div class="chart-panel">
            <div class="panel-header">
                <h2 id="mood-cal-title" data-tooltip="Month-view calendar; each day is coloured by mood score (red→green) with the score centred on the cell. Use ‹/›/dropdown to jump months.">Mood Calendar</h2>
                <span id="mood-cal-avg" class="mood-cal-avg"></span>
                <div class="range-controls" id="mood-cal-nav">
                    <button class="range-btn" id="mood-cal-prev" aria-label="Previous month">‹</button>
                    <select id="mood-cal-select" class="mood-cal-select" aria-label="Jump to month"></select>
                    <button class="range-btn" id="mood-cal-next" aria-label="Next month">›</button>
                </div>
            </div>
            <div class="mood-cal-dow">
                <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
            </div>
            <div class="mood-cal-grid" id="mood-cal-grid"></div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">No mood data yet. Record a 1–10 score on the Day tab to start building this view.</div>
    {% endif %}
    </div>
