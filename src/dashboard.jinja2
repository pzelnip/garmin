        <div class="chart-panel wide">
            <h2 data-tooltip="Stacked nightly breakdown of Deep / REM / Light / Awake minutes for the last 90 nights. Tooltip on hover shows the per-stage hours and minutes.">Sleep Stage Breakdown — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="sleepStagesChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="Average sleep hours (left axis) and average sleep score (right axis) per weekday. Best night for hours is highlighted.">Sleep by Day of Week — Hours &amp; Score</h2>
            <div class="chart-wrap"><canvas id="sleepDowChart"></canvas></div>
            {% if data.stats.sleep_dow_best %}
                {% set delta_min = (data.stats.sleep_dow_best.delta * 60) | round | int %}
