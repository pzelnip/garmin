            <div class="heatmap-dow">
                <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
            </div>
            <div class="heatmap" id="hydHeatmap"></div>
        </div>
        <div class="legend">
            <span class="legend-cell l-1"></span><span>No data</span>
            <span class="legend-cell hyd-l0"></span><span>None</span>
            <span class="legend-cell hyd-l1"></span><span>&lt; 50%</span>
            <span class="legend-cell hyd-l2"></span><span>50 – 75%</span>
            <span class="legend-cell hyd-l3"></span><span>75 – 100%</span>
            <span class="legend-cell hyd-l4"></span><span>Goal met</span>
        </div>
    </div>

    <div class="chart-grid">
        {{ weekly_comparison_panel(data.stats.hyd_weekly_comparison, 'water', 'ml') }}

        <div class="chart-panel wide">
            <h2 data-tooltip="Daily water consumption (bars) against each day's hydration goal (line) for the last 90 days.">Daily Hydration vs Goal — Last 90 Days</h2>
            <div class="chart-wrap tall"><canvas id="hydTimelineChart"></canvas></div>
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="Average water intake per weekday across all tracked days. The bar with the highest average is highlighted.">Average Water by Day of Week</h2>
            <div class="chart-wrap"><canvas id="hydDowChart"></canvas></div>
            {% if data.stats.hyd_dow_best %}
                {{ dow_best_footer(data.stats.hyd_dow_best, "{:,} ml above weekly average".format(data.stats.hyd_dow_best.delta|int)) }}
            {% endif %}
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="One point per day where both steps and water are recorded. Useful for spotting whether active days correlate with hydration.">Steps vs Water (last 365 days)</h2>
            <div class="chart-wrap"><canvas id="hydScatterChart"></canvas></div>
        </div>
    </div>
    {% else %}
    <div class="empty-state">No hydration data yet. Once Garmin Connect logs water intake for a day, it will show up here.</div>
    {% endif %}
    </div>
    <!-- /WATER TAB -->

    <!-- ============================ SLEEP TAB ============================ -->
    <div class="tab-panel" data-tab="sleep">
    {% if data.stats.sleep_total_days %}
    <!-- Headline + insight cards -->
    <div class="grid">
        <div class="panel mood-avg-panel"
             data-tooltip="All-time average sleep duration across {{ data.stats.sleep_total_days }} nights with data. Sparkline shows the last 30 nights' hours; the score delta below compares recent score vs all-time.">
            <div class="stat-label">Avg Sleep / Night (All-Time)</div>
            <div class="mood-avg-row">
                <div class="stat-value sleep">{{ data.stats.sleep_avg_hours_str }}</div>
                {% if data.stats.sleep_score_30d_delta is not none %}
                    {% set d = data.stats.sleep_score_30d_delta %}
                    <div class="mood-avg-delta {{ 'delta-up' if d > 0 else ('delta-down' if d < 0 else 'delta-flat') }}">
                        {% if d > 0 %}▲{% elif d < 0 %}▼{% else %}■{% endif %}
                        {{ d|abs }} score over previous 30 nights
                    </div>
                {% endif %}
            </div>
            <div class="ki-viz"><canvas id="sleepAvgSparkline"></canvas></div>
        </div>

        {% if data.stats.sleep_dow_best %}
