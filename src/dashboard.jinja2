            {% endif %}
        </div>
        <div class="chart-panel">
            <h2 data-tooltip="One point per night where both duration and score are recorded. X = hours slept, Y = sleep score (0–100).">Sleep Duration vs Score (last 365 days)</h2>
            <div class="chart-wrap"><canvas id="sleepScatterChart"></canvas></div>
        </div>
