    <!-- ============================ GOALS TAB ============================ -->
    {# The ladder is data-driven from goals.json (see _load_goals in app.py),
       read fresh on every request — so milestones can be updated by hand-
       editing that file on the Pi (no code change / commit / redeploy).
       Each rung has status "done" | "current" | "future"; the summit and the
       progress totals (done / total / pct) are derived server-side. #}
    <div class="tab-panel" data-tab="goals">
        <div class="goals-intro">
            <p>The training ladder I built with my physio. The bottom rung is
            where I started; the summit is the ultimate goal — a
            <strong>TC 10K personal best</strong>. Each rung in between is an
            intermediate milestone on the way up.</p>
            <p class="goals-tagline">Every rung climbed makes the next one possible.</p>
        </div>

        {% if goals %}
        <div class="goals-progress">
            <div class="goals-progress-num">{{ goals.done }}<small>&nbsp;/&nbsp;{{ goals.total }}</small></div>
            <div class="goals-progress-bar">
                <div class="goals-progress-fill" style="width: {{ goals.pct }}%;"></div>
            </div>
            <div class="goals-progress-label">{{ goals.done }} rung{{ '' if goals.done == 1 else 's' }} climbed</div>
        </div>

        {% macro rung(r) %}
            <div class="rung {{ r.status }}">
                <div class="rung-track">
                    <div class="bar"></div>
                    {% if r.status == 'current' %}<span class="rider">🧗</span>{% endif %}
                </div>
                <div class="rung-body">
                    <div class="rung-date">{% if r.status == 'done' %}✓ {% endif %}{{ r.date }}</div>
                    <div class="rung-title">{{ r.title }}</div>
                    {% if r.note %}<div class="rung-note">{{ r.note }}</div>{% endif %}
                </div>
            </div>
        {% endmacro %}

        <div class="ladder">
            <div class="rail left"></div>
            <div class="rail right"></div>

            {% if goals.summit %}
            <div class="rung summit">
                <div class="rung-track"><div class="bar"></div><span class="rider">🏆</span></div>
                <div class="rung-body">
                    <div class="rung-date">{{ goals.summit.date }}</div>
                    <div class="rung-title">{{ goals.summit.title }}</div>
                </div>
            </div>
            {% endif %}

            {% for phase in goals.phases %}
            <div class="ladder-phase">{{ phase.name }}</div>
            {% for r in phase.rungs %}{{ rung(r) }}{% endfor %}
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">Couldn't load the goals ladder — goals.json is missing or invalid.</div>
        {% endif %}

        <div class="goals-footer">
            <p><strong>Progress isn't measured in speed.</strong></p>
            <p>Each rung climbed becomes the foundation for the next.</p>
        </div>
    </div>
    <!-- /GOALS TAB -->

