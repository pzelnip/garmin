    <!-- Headline + insight cards -->
    <div class="grid">
        <div class="panel mood-avg-panel"
             data-tooltip="All-time average water intake across {{ data.stats.hyd_total_days }} days with hydration data. Sparkline shows the last 30 logged days; delta compares them against the all-time average.">
