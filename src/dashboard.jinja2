            <div class="ki-row">
                {% set s = data.stats.sleep_avg_score %}
                {% set klass = 'ki-icon-great' if s >= 80 else ('ki-icon-rough' if s < 60 else 'ki-icon-neutral') %}
                <div class="ki-icon {{ klass }}">⭐</div>
                <div class="ki-body">
                    <div class="ki-title">{{ s }} / 100</div>
                    <div class="ki-sub">across {{ data.stats.sleep_scored_days }} scored nights</div>
                </div>
            </div>
            <div class="ki-viz"><canvas id="sleepScoreSparkline"></canvas></div>
        </div>

        <div class="panel ki-panel"
             data-tooltip="Nights in the last 14 logged where total sleep was under 6 hours. Strip below shows the same 14 nights — green = ≥6h, dim = under 6h.">
            <div class="stat-label">Short Nights (Last 14)</div>
