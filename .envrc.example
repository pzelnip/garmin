export GARMIN_EMAIL=""
export GARMIN_PASSWORD=""

# database connection string
export CONN_STR=""

# example of sqlite database connection string:
# export CONN_STR="sqlite:///the_database_file.db"

# example of postgresql database connection string:
# export CONN_STR="postgresql://user:password@host:port/database"

# healthchecks.io url, ex: https://hc-ping.com/<some uuid>
export HEALTHCHECKS_URL=""

# Set to 1, true, or yes to enable Flask's reloader / debugger locally.
# Leave unset (or set to anything else) for production mode on the Pi.
export GARMIN_DASHBOARD_DEBUG=1
